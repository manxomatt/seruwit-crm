{
  "info": {
    "name": "Seruwit Mobile Booking API v1 (Travel + Rental)",
    "description": "JSON API untuk aplikasi mobile Capacitor (Travel shuttle + Rental).\n\n**Base path:** `/api/mobile/v1` di **domain tenant**.\n\n**Auth bersama:** OTP HP → Bearer `{{token}}` (aktif jika Travel dan/atau Rental surface enabled).\n\n**Alur Travel:** Health → Bootstrap → OTP → Corridors/Departures → Hold → Ticket → Pay/Cancel → History\n\n**Alur Rental:** Health → Bootstrap → OTP → Vehicles/Quote → Booking → Pay deposit/Cancel → History\n\n**Enable surfaces:**\n- Travel: `shuttle_settings.passenger_booking_enabled=1`\n- Rental: setting `rental.passenger_booking_enabled=1`\n\nSet `baseUrl` ke domain tenant (contoh `https://andito.seruwit-crm.test`). Setelah Verify OTP, `token` terisi otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://andito.seruwit-crm.test" },
    { "key": "token", "value": "" },
    { "key": "phone", "value": "08123456789" },
    { "key": "otpCode", "value": "" },
    { "key": "corridorId", "value": "1" },
    { "key": "departureId", "value": "1" },
    { "key": "departDate", "value": "2026-08-05" },
    { "key": "publicToken", "value": "" },
    { "key": "vehicleId", "value": "1" },
    { "key": "startDate", "value": "2026-08-10" },
    { "key": "endDate", "value": "2026-08-12" },
    { "key": "rentalPublicToken", "value": "" },
    { "key": "idempotencyKey", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "0. Platform",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/mobile/v1/health"
          }
        },
        {
          "name": "Bootstrap",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-App-Version", "value": "1.0.0" }
            ],
            "url": "{{baseUrl}}/api/mobile/v1/bootstrap",
            "description": "Cek `surfaces.shuttle.enabled` (Travel) dan `surfaces.rental.enabled`."
          }
        }
      ]
    },
    {
      "name": "1. Auth (shared)",
      "item": [
        {
          "name": "Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.debug_code) { pm.collectionVariables.set('otpCode', j.debug_code); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": "{{baseUrl}}/api/mobile/v1/auth/otp/send"
          }
        },
        {
          "name": "Verify OTP (issue Bearer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) { pm.collectionVariables.set('token', j.token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{otpCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/mobile/v1/auth/otp/verify"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/mobile/v1/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/mobile/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "2. Travel — Catalog",
      "item": [
        {
          "name": "List corridors",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.data && j.data[0]) { pm.collectionVariables.set('corridorId', String(j.data[0].id)); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/mobile/v1/shuttle/corridors"
          }
        },
        {
          "name": "List departures",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.data && j.data[0]) { pm.collectionVariables.set('departureId', String(j.data[0].id)); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/mobile/v1/shuttle/departures?date={{departDate}}&corridor_id={{corridorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile", "v1", "shuttle", "departures"],
              "query": [
                { "key": "date", "value": "{{departDate}}" },
                { "key": "corridor_id", "value": "{{corridorId}}" }
              ]
            }
          }
        },
        {
          "name": "Geocode reverse",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/mobile/v1/shuttle/geocode/reverse?lat=-6.2&lng=106.8",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile", "v1", "shuttle", "geocode", "reverse"],
              "query": [
                { "key": "lat", "value": "-6.2" },
                { "key": "lng", "value": "106.8" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Travel — Booking",
      "item": [
        {
          "name": "Create hold (Bearer)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.booking && j.booking.public_token) {",
                  "    pm.collectionVariables.set('publicToken', j.booking.public_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departure_id\": {{departureId}},\n  \"passenger_count\": 1,\n  \"pickup_mode\": \"pool\",\n  \"dropoff_mode\": \"pool\",\n  \"notes\": null,\n  \"passengers\": [\n    { \"name\": \"Budi Santoso\", \"phone\": \"{{phone}}\", \"id_number\": null }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/mobile/v1/shuttle/holds"
          }
        },
        {
          "name": "Create hold (OTP dual-mode, no Bearer)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departure_id\": {{departureId}},\n  \"passenger_count\": 1,\n  \"pickup_mode\": \"pool\",\n  \"dropoff_mode\": \"pool\",\n  \"booker_phone\": \"{{phone}}\",\n  \"otp_code\": \"{{otpCode}}\",\n  \"passengers\": [\n    { \"name\": \"Budi Santoso\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/mobile/v1/shuttle/holds"
          }
        },
        {
          "name": "Get ticket",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/mobile/v1/shuttle/tickets/{{publicToken}}"
          }
        },
        {
          "name": "Pay (gateway)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": "{{baseUrl}}/api/mobile/v1/shuttle/tickets/{{publicToken}}/pay"
          }
        },
        {
          "name": "Cancel ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancel_reason\": \"Berubah pikiran\"\n}"
            },
            "url": "{{baseUrl}}/api/mobile/v1/shuttle/tickets/{{publicToken}}/cancel"
          }
        },
        {
          "name": "My travel bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/mobile/v1/shuttle/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile", "v1", "shuttle", "bookings"],
              "query": [
                { "key": "status", "value": "draft", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Rental — Catalog",
      "item": [
        {
          "name": "Classes",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/mobile/v1/rental/classes"
          }
        },
        {
          "name": "Vehicles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.data && j.data[0]) { pm.collectionVariables.set('vehicleId', String(j.data[0].id)); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/mobile/v1/rental/vehicles?start_date={{startDate}}&end_date={{endDate}}&available_only=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile", "v1", "rental", "vehicles"],
              "query": [
                { "key": "start_date", "value": "{{startDate}}" },
                { "key": "end_date", "value": "{{endDate}}" },
                { "key": "available_only", "value": "1" },
                { "key": "rental_class", "value": "mpv", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Vehicle detail",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/mobile/v1/rental/vehicles/{{vehicleId}}"
          }
        },
        {
          "name": "Locations",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/mobile/v1/rental/locations"
          }
        },
        {
          "name": "Insurance packages",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/mobile/v1/rental/insurance-packages?period_type=daily",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile", "v1", "rental", "insurance-packages"],
              "query": [{ "key": "period_type", "value": "daily" }]
            }
          }
        },
        {
          "name": "Quote",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": {{vehicleId}},\n  \"start_date\": \"{{startDate}}\",\n  \"end_date\": \"{{endDate}}\",\n  \"period_type\": \"daily\"\n}"
            },
            "url": "{{baseUrl}}/api/mobile/v1/rental/quotes"
          }
        }
      ]
    },
    {
      "name": "5. Rental — Booking",
      "item": [
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.booking && j.booking.public_token) {",
                  "    pm.collectionVariables.set('rentalPublicToken', j.booking.public_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": {{vehicleId}},\n  \"start_date\": \"{{startDate}}\",\n  \"end_date\": \"{{endDate}}\",\n  \"period_type\": \"daily\",\n  \"customer_name\": \"Budi Santoso\"\n}"
            },
            "url": "{{baseUrl}}/api/mobile/v1/rental/bookings"
          }
        },
        {
          "name": "Get booking",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/mobile/v1/rental/bookings/{{rentalPublicToken}}"
          }
        },
        {
          "name": "Pay deposit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": "{{baseUrl}}/api/mobile/v1/rental/bookings/{{rentalPublicToken}}/pay-deposit"
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelled_reason\": \"Berubah pikiran\"\n}"
            },
            "url": "{{baseUrl}}/api/mobile/v1/rental/bookings/{{rentalPublicToken}}/cancel"
          }
        },
        {
          "name": "My rental bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/mobile/v1/rental/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mobile", "v1", "rental", "bookings"],
              "query": [
                { "key": "status", "value": "confirmed", "disabled": true }
              ]
            }
          }
        }
      ]
    }
  ]
}
